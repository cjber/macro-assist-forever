package-as: MacroAssistForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - .agents
  - .bugpatrol
  - .editorconfig
  - .github
  - .gitattributes
  - .gitignore
  - .gitleaks.toml
  - .luacheckrc
  - .luarc.json
  - .sloppatrol
  - .speedpatrol
  - .styluaignore
  - AGENTS.md
  - CHANGELOG.md
  - docs
  - media/icon.svg
  - media/icon-400.png
  - reference
  - ruff.toml
  - stylua.toml
  - tests
  - tools
  - types
  - forever-core

# ForeverCore ships inside this zip as its own folder, from the release tools/forever-core.txt pins, because
# its CurseForge project is not yet approved and so cannot be a required-dependencies relation.
externals:
  ForeverCore: https://github.com/cjber/forever-core/releases/download/v1.1.0/ForeverCore-v1.1.0-forever.zip

move-folders:
  MacroAssistForever/ForeverCore: ForeverCore
