package-as: MacroAssistForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - .agents
  - .bugpatrol
  - .editorconfig
  - .github
  - .gitattributes
  - .gitignore
  - .gitleaks.toml
  - .luacheckrc
  - .luarc.json
  - .sloppatrol
  - .speedpatrol
  - .styluaignore
  - AGENTS.md
  - CHANGELOG.md
  - docs
  - media/icon.svg
  - media/icon-400.png
  - reference
  - ruff.toml
  - stylua.toml
  - tests
  - tools
  - types
  - forever-core

# ForeverCore ships inside this zip as its own folder, at the release tools/forever-core.txt pins, so an
# update brings it along: players who updated did not get it as a required dependency, and Wago's uploads
# carry no dependencies at all.
externals:
  ForeverCore: https://github.com/cjber/forever-core/releases/download/v1.7.4/ForeverCore-v1.7.4-forever.zip

move-folders:
  MacroAssistForever/ForeverCore: ForeverCore
