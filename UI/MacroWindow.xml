<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- One macro in the scroll box. The row highlight atlases are stretched across the row exactly as Blizzard's
	     own auction house list stretches them; art-ok: auctionhouse-ui-row-select/highlight are row fills. -->
	<Button name="MacroAssistRowTemplate" virtual="true" motionScriptsWhileDisabled="true">
		<Size y="46"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Selected" atlas="auctionhouse-ui-row-select" alpha="0.8" alphaMode="ADD" setAllPoints="true" hidden="true"/>
				<Texture parentKey="Highlight" atlas="auctionhouse-ui-row-highlight" alpha="0.22" alphaMode="ADD" setAllPoints="true" hidden="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="18" y="18"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="5" y="-6"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Name" inherits="GameFontHighlightSmall" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="TOPRIGHT" x="6" y="-1"/>
						<Anchor point="RIGHT" x="-6"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Summary" inherits="GameFontHighlightSmall" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Name" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
						<Anchor point="RIGHT" x="-6"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Button>
</Ui>
